{
    "name": "billingserv/php-sdk",
    "description": "Official PHP SDK for the BillingServ v2 API",
    "type": "library",
    "license": "MIT",
    "keywords": ["billingserv", "billing", "hosting", "api", "sdk"],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11"
    },
    "autoload": {
        "psr-4": {
            "BillingServ\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BillingServ\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
